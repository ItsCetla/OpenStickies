{
  "name": "openstickies",
  "productName": "OpenStickies",
  "version": "3.1.0",
  "description": "Desktop sticky notes with rich HTML formatting, images, checklists, reminders and more.",
  "keywords": [
    "sticky notes",
    "stickies",
    "notes",
    "windows",
    "desktop",
    "electron",
    "checklist",
    "todo",
    "reminders",
    "screen snip",
    "ocr",
    "opencode"
  ],
  "homepage": "https://openstickies.cetla.dev/",
  "bugs": {
    "url": "https://github.com/ItsCetla/OpenStickies/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsCetla/OpenStickies.git"
  },
  "main": "src/main/main.js",
  "author": "OpenStickies",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "postinstall": "node node_modules/electron/install.js",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/screenshots/capture.js",
    "dist": "electron-builder --win nsis portable",
    "dist:portable": "electron-builder --win portable",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "check:locales": "node scripts/check-locales.js"
  },
  "build": {
    "appId": "com.openstickies.desktop",
    "productName": "OpenStickies",
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "guid": "6b9a4f2d-30d2-5e19-b66e-ec9ae51074c9",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenStickies",
      "artifactName": "OpenStickies-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OpenStickies-Portable-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns",
      "hardenedRuntime": false,
      "identity": "-",
      "darkModeSupport": true,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "LSUIElement": false
      }
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "assets/icon.png",
      "executableName": "openstickies",
      "maintainer": "ItsCetla <ItsCetla@users.noreply.github.com>",
      "synopsis": "Desktop sticky notes",
      "description": "Desktop sticky notes with rich HTML formatting, images, checklists, reminders and more.",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "OpenStickies",
          "Comment": "Desktop sticky notes",
          "StartupWMClass": "OpenStickies",
          "Keywords": "sticky;notes;stickies;todo;"
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
